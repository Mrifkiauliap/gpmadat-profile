---
interface Props {
  nama: string;
  jabatan: string;
  kelompok?: string;
  featured?: boolean;
}

const { nama, jabatan, kelompok, featured = false } = Astro.props;
const initials = nama
  .split(' ')
  .filter(Boolean)
  .map((n) => n[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

{
  featured ? (
    <div class="card relative overflow-hidden bg-padi-900! p-8 text-center sm:p-10">
      <div class="motif-band absolute inset-x-0 top-0 opacity-60" />
      <div class="mx-auto flex h-24 w-24 items-center justify-center rounded-full border-2 border-clay-400 font-display text-3xl font-semibold text-clay-300">
        {initials}
      </div>
      <p class="mt-5 font-display text-2xl font-semibold tracking-tight text-paper">{nama}</p>
      <p class="mt-1 text-sm font-medium text-clay-300">{jabatan}</p>
      {kelompok && (
        <p class="mt-3 inline-block border border-padi-700 px-3 py-1 text-[0.625rem] font-semibold uppercase tracking-[0.14em] text-padi-200">
          {kelompok}
        </p>
      )}
    </div>
  ) : (
    <div class="card card-hover group flex items-center gap-4 p-5">
      <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-padi-100 font-display text-lg font-semibold text-padi-700 transition-colors group-hover:bg-clay-100 group-hover:text-clay-700">
        {initials}
      </div>
      <div class="min-w-0">
        <p class="truncate font-display text-lg font-semibold leading-tight text-padi-900">{nama}</p>
        <p class="mt-0.5 text-sm text-ink-2">{jabatan}</p>
        {kelompok && (
          <p class="mt-1 text-[0.625rem] font-semibold uppercase tracking-[0.14em] text-ink-3">
            {kelompok}
          </p>
        )}
      </div>
    </div>
  )
}
