---
interface Props {
  nama: string;
  jabatan: string;
  kelompok?: string;
  featured?: boolean;
}

const { nama, jabatan, kelompok, featured = false } = Astro.props;

// Tidak memakai pas foto aparatur — monogram inisial dipakai sebagai penanda
// tipografis agar tampilan tetap konsisten dan disengaja, bukan foto kosong.
const initials = nama
  .split(' ')
  .filter(Boolean)
  .map((n) => n[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

{
  featured ? (
    <div class="card relative overflow-hidden bg-padi-900! p-8 text-center sm:p-10">
      <div class="motif-band absolute inset-x-0 top-0 opacity-60" />

      <div class="relative mx-auto mt-2 inline-flex h-24 w-24 items-center justify-center">
        <span class="absolute inset-0 rotate-45 border border-clay-500/45" />
        <span class="absolute inset-[7px] border border-clay-400/70" />
        <span class="relative font-display text-3xl font-semibold tracking-tight text-clay-300">
          {initials}
        </span>
      </div>

      <p class="mt-6 font-display text-2xl font-semibold tracking-tight text-paper">{nama}</p>
      <p class="mt-1.5 text-sm font-medium text-clay-300">{jabatan}</p>

      {kelompok && (
        <p class="mt-4 inline-block border border-padi-700 px-3 py-1 text-[0.625rem] font-semibold uppercase tracking-[0.14em] text-padi-200">
          {kelompok}
        </p>
      )}
    </div>
  ) : (
    <div class="card card-hover group relative flex items-center gap-4 overflow-hidden p-5">
      <span class="absolute inset-y-0 left-0 w-[3px] origin-top scale-y-0 bg-clay-500 transition-transform duration-300 ease-out group-hover:scale-y-100" />

      <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-[3px] border border-line bg-padi-50 font-display text-lg font-semibold tracking-tight text-padi-700 transition-colors duration-200 group-hover:border-clay-300 group-hover:bg-clay-50 group-hover:text-clay-700">
        {initials}
      </div>

      <div class="min-w-0">
        <p class="text-[0.625rem] font-semibold uppercase tracking-[0.14em] text-ink-3">
          {jabatan}
        </p>
        <p class="mt-1 truncate font-display text-lg font-semibold leading-tight text-padi-900">
          {nama}
        </p>
        {kelompok && <p class="mt-0.5 text-xs text-ink-3">{kelompok}</p>}
      </div>
    </div>
  )
}
