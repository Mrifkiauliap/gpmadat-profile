---
import { Icon } from 'astro-icon/components';

interface Props {
  icon?: string;
  label: string;
  value: string;
  sub?: string;
}

const { icon, label, value, sub } = Astro.props;
---

<div class="card relative overflow-hidden p-6">
  <span class="absolute inset-y-0 left-0 w-[3px] bg-clay-500"></span>

  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-ink-3">{label}</p>
      <p class="stat-figure mt-2.5 text-4xl text-padi-800">{value}</p>
      {sub && <p class="mt-1.5 text-sm text-ink-3">{sub}</p>}
    </div>
    {icon && <Icon name={`lucide:${icon}`} class="h-6 w-6 shrink-0 text-padi-300" />}
  </div>
</div>
