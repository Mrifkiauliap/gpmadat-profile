---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="mt-3 font-display text-[1.75rem] font-semibold leading-[1.15] text-padi-900 sm:text-4xl">
    {title}
  </h2>
  {description && <p class="mt-3 leading-relaxed text-ink-2">{description}</p>}
</div>
