---
import { Icon } from 'astro-icon/components';

interface Props {
  nama: string;
  icon: string;
  jumlahUsaha: string;
  deskripsi: string;
  komoditas: string[];
}

const { nama, icon, jumlahUsaha, deskripsi, komoditas } = Astro.props;
---

<div class="card card-hover group flex flex-col p-6">
  <div class="flex items-center justify-between">
    <div
      class="flex h-12 w-12 items-center justify-center rounded-[3px] bg-padi-50 text-padi-700 transition-colors group-hover:bg-clay-50 group-hover:text-clay-600"
    >
      <Icon name={`lucide:${icon}`} class="h-6 w-6" />
    </div>
    <span class="text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-ink-3">
      {jumlahUsaha}
    </span>
  </div>

  <h3 class="mt-5 font-display text-xl font-semibold leading-snug text-padi-900">{nama}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-2">{deskripsi}</p>

  <div class="mt-5 border-t border-line pt-4">
    <p class="text-[0.625rem] font-semibold uppercase tracking-[0.14em] text-ink-3">Komoditas</p>
    <ul class="mt-2.5 flex flex-wrap gap-1.5">
      {
        komoditas.map((item) => (
          <li class="border border-line bg-paper-2 px-2.5 py-1 text-xs text-ink-2">{item}</li>
        ))
      }
    </ul>
  </div>
</div>
