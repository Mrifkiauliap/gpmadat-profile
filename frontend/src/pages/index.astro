---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatCard from '../components/StatCard.astro';
import ActivityCard from '../components/ActivityCard.astro';
import PotensiCard from '../components/PotensiCard.astro';
import { site } from '../data/site';
import { profil, wilayah } from '../data/profil';
import { penduduk } from '../data/penduduk';
import { potensi } from '../data/potensi';
import { fasilitas, totalFasilitas } from '../data/fasilitas';

const kegiatanTerbaru = (await getCollection('kegiatan'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const potensiUnggulan = potensi.slice(0, 3);
const hasHeroImage = Boolean(site.heroImage);
---

<Layout>
  <!-- ================= HERO ================= -->
  <section class="relative overflow-hidden border-b border-line">
    {
      hasHeroImage ? (
        <>
          <img
            src={site.heroImage ?? ''}
            alt=""
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-padi-950/78" />
        </>
      ) : (
        <div class="absolute inset-0 bg-padi-950">
          <div
            class="absolute inset-0 opacity-[0.07]"
            style="background-image: radial-gradient(circle at 1px 1px, #faf6ef 1px, transparent 0); background-size: 26px 26px;"
          />
          <div
            class="absolute -right-40 -top-40 h-[34rem] w-[34rem] rounded-full opacity-25 blur-3xl"
            style="background: radial-gradient(circle, #c96f35 0%, transparent 70%);"
          />
        </div>
      )
    }

    <div class="relative mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <div class="grid items-end gap-12 lg:grid-cols-[1.35fr_1fr]">
        <div>
          <p class="eyebrow rise text-clay-300!" style="animation-delay: 60ms">
            {site.kecamatan} • {site.kabupaten}
          </p>

          <h1
            class="rise mt-6 font-display text-[2.75rem] font-semibold leading-[1.03] tracking-[-0.03em] text-paper sm:text-6xl lg:text-[4.25rem]"
            style="animation-delay: 140ms"
          >
            Portal Resmi<br />
            <span class="italic text-clay-300">{site.name}</span>
          </h1>

          <p
            class="rise mt-7 max-w-xl text-[1.0625rem] leading-relaxed text-paper-3/80"
            style="animation-delay: 220ms"
          >
            {profil.visi}
          </p>

          <div class="rise mt-9 flex flex-wrap gap-3" style="animation-delay: 300ms">
            <a href="/profil" class="btn bg-clay-500 text-paper hover:bg-clay-600">
              Jelajahi Profil Desa
              <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </a>
            <a
              href="/peta"
              class="btn border border-paper/30 text-paper hover:bg-paper hover:text-padi-900"
            >
              <Icon name="lucide:map" class="h-4 w-4" />
              Lihat Peta Wilayah
            </a>
          </div>
        </div>

        <!-- Ringkasan angka, gaya tabel cetak -->
        <dl
          class="rise divide-y divide-padi-800 border-t-2 border-clay-500"
          style="animation-delay: 380ms"
        >
          {
            [
              { label: 'Jiwa Penduduk', value: penduduk.totalJiwa.toLocaleString('id-ID') },
              { label: 'Kepala Keluarga', value: penduduk.totalKK.toLocaleString('id-ID') },
              { label: 'Wilayah Dusun', value: String(penduduk.dusun.length) },
              { label: 'Sektor Potensi', value: String(potensi.length) },
            ].map((row) => (
              <div class="flex items-baseline justify-between gap-6 py-4">
                <dt class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-padi-300">
                  {row.label}
                </dt>
                <dd class="stat-figure text-3xl text-paper">{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <div class="motif-band"></div>
  </section>

  <!-- ================= SEKILAS ================= -->
  <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
      <SectionHeading
        eyebrow="Sekilas Gampong"
        title="Pusat pemerintahan kecamatan yang tumbuh dari sawah dan gotong royong."
      />
      <div class="space-y-6">
        <p class="text-[1.0625rem] leading-[1.75] text-ink-2">
          {profil.gambaranUmum[0]}
        </p>
        <p class="leading-[1.75] text-ink-2">
          {profil.gambaranUmum[1]}
        </p>
        <div class="grid gap-4 sm:grid-cols-3">
          {
            [
              { icon: 'ruler', label: 'Luas Wilayah', value: `${wilayah.luasHektar.toLocaleString('id-ID')} Ha` },
              { icon: 'users', label: 'Penduduk', value: `${penduduk.totalJiwa.toLocaleString('id-ID')} Jiwa` },
              { icon: 'building-2', label: 'Sarana Umum', value: `${totalFasilitas} Unit` },
            ].map((item) => (
              <div class="border-l-2 border-clay-400 pl-4">
                <Icon name={`lucide:${item.icon}`} class="h-5 w-5 text-padi-500" />
                <p class="mt-2.5 font-display text-xl font-semibold text-padi-900">{item.value}</p>
                <p class="text-xs font-medium uppercase tracking-[0.12em] text-ink-3">
                  {item.label}
                </p>
              </div>
            ))
          }
        </div>
        <a href="/profil" class="link-underline inline-block text-sm">Baca profil lengkap</a>
      </div>
    </div>
  </section>

  <!-- ================= SARANA ================= -->
  <section class="border-t border-line bg-padi-950 py-20 text-paper-3">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div class="max-w-2xl">
          <p class="eyebrow text-clay-300!">Sarana & Prasarana</p>
          <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-paper sm:text-4xl">
            {totalFasilitas} sarana layanan publik
          </h2>
          <p class="mt-3 leading-relaxed text-paper-3/70">
            Sebagai pusat pemerintahan Kecamatan Madat, gampong ini memiliki sarana pemerintahan,
            pendidikan, kesehatan, peribadatan, hingga keamanan.
          </p>
        </div>
        <a
          href="/profil"
          class="inline-flex items-center gap-2 border-b border-clay-500/50 pb-1 text-sm font-semibold text-clay-300 transition-colors hover:border-clay-400 hover:text-clay-200"
        >
          Lihat rincian sarana
          <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
        </a>
      </div>

      <div class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          fasilitas.map((k) => (
            <div class="border-t-2 border-clay-500/70 pt-5">
              <div class="flex items-center gap-2.5">
                <Icon name={`lucide:${k.icon}`} class="h-5 w-5 text-clay-400" />
                <h3 class="font-display text-lg font-semibold text-paper">{k.kategori}</h3>
              </div>
              <ul class="mt-4 space-y-1.5">
                {k.items.map((f) => (
                  <li class="text-sm text-paper-3/75">{f.nama}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= KEGIATAN ================= -->
  <section class="border-y border-line bg-paper-2/60 py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <SectionHeading
          eyebrow="Dokumentasi"
          title="Kegiatan Terbaru"
          description="Catatan aktivitas warga dan pemerintah Gampong Madat."
        />
        <a href="/kegiatan" class="link-underline text-sm">Lihat semua kegiatan</a>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          kegiatanTerbaru.map((item) => (
            <ActivityCard
              title={item.data.title}
              date={item.data.date}
              excerpt={item.data.excerpt}
              cover={item.data.cover}
              href={`/kegiatan/${item.id}`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= POTENSI ================= -->
  <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-5">
      <SectionHeading
        eyebrow="Ekonomi Warga"
        title="Potensi Unggulan Gampong"
        description="Sektor usaha yang menopang penghidupan masyarakat Gampong Madat."
      />
      <a href="/potensi" class="link-underline text-sm">Lihat semua potensi</a>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {potensiUnggulan.map((item) => <PotensiCard {...item} />)}
    </div>
  </section>

  <!-- ================= AJAKAN ================= -->
  <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8">
    <div class="relative overflow-hidden bg-padi-900 px-8 py-14 sm:px-14">
      <div
        class="absolute inset-0 opacity-[0.06]"
        style="background-image: radial-gradient(circle at 1px 1px, #faf6ef 1px, transparent 0); background-size: 24px 24px;"
      >
      </div>

      <div class="relative flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
        <div class="max-w-xl">
          <p class="eyebrow text-clay-300!">Layanan Gampong</p>
          <h2 class="mt-4 font-display text-3xl font-semibold leading-tight text-paper sm:text-4xl">
            Ada yang ingin ditanyakan kepada perangkat gampong?
          </h2>
          <p class="mt-3 leading-relaxed text-paper-3/75">
            Kunjungi kantor gampong pada jam layanan, atau hubungi kami melalui kanal resmi.
          </p>
        </div>
        <a href="/kontak" class="btn shrink-0 bg-clay-500 text-paper hover:bg-clay-600">
          Hubungi Kami
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>
</Layout>
