---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { galeri } from '../data/galeri';
---

<Layout title="Galeri" description="Galeri foto kegiatan Gampong Madat.">
  <PageHeader
    eyebrow="Dokumentasi Visual"
    title="Galeri Gampong"
    description="Potret kegiatan, suasana, dan wajah keseharian Gampong Madat."
  />

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        galeri.map((item, i) => (
          <figure
            class:list={[
              'card card-hover group overflow-hidden',
              i % 5 === 0 && 'sm:col-span-2',
            ]}
          >
            <div
              class:list={[
                'overflow-hidden bg-paper-2',
                i % 5 === 0 ? 'aspect-[16/9]' : 'aspect-[4/3]',
              ]}
            >
              <img
                src={item.gambar}
                alt={item.judul}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </div>
            <figcaption class="flex items-baseline justify-between gap-4 border-t border-line p-4">
              <p class="font-display text-base font-semibold leading-snug text-padi-900">
                {item.judul}
              </p>
              {item.tanggal && (
                <time
                  datetime={item.tanggal}
                  class="shrink-0 text-[0.6875rem] font-medium uppercase tracking-[0.1em] text-ink-3"
                >
                  {new Date(item.tanggal).toLocaleDateString('id-ID', {
                    month: 'short',
                    year: 'numeric',
                  })}
                </time>
              )}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>
</Layout>
