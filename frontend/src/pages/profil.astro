---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { profil, wilayah } from '../data/profil';
import { penduduk } from '../data/penduduk';
import { fasilitas, totalFasilitas } from '../data/fasilitas';
import { site } from '../data/site';

const arahIcon: Record<string, string> = {
  Utara: 'arrow-up',
  Selatan: 'arrow-down',
  Timur: 'arrow-right',
  Barat: 'arrow-left',
};

const ringkas = [
  { icon: 'ruler', label: 'Luas Wilayah', value: `${wilayah.luasHektar.toLocaleString('id-ID')} Ha` },
  { icon: 'compass', label: 'Jumlah Dusun', value: `${wilayah.jumlahDusun} Dusun` },
  { icon: 'users', label: 'Penduduk', value: `${penduduk.totalJiwa.toLocaleString('id-ID')} Jiwa` },
  { icon: 'building-2', label: 'Sarana Umum', value: `${totalFasilitas} Unit` },
];
---

<Layout title="Profil Desa" description="Gambaran umum, visi misi, batas wilayah, dan sarana Gampong Madat.">
  <PageHeader
    eyebrow="Profil Gampong"
    title={`Mengenal ${site.name}`}
    description="Gambaran umum wilayah, arah pembangunan, batas gampong, serta sarana dan prasarana yang tersedia."
  />

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <!-- Ringkasan angka -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        ringkas.map((r) => (
          <div class="card p-5">
            <Icon name={`lucide:${r.icon}`} class="h-5 w-5 text-padi-500" />
            <p class="stat-figure mt-3 text-2xl text-padi-800">{r.value}</p>
            <p class="mt-1 text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-ink-3">
              {r.label}
            </p>
          </div>
        ))
      }
    </div>

    <!-- Gambaran umum -->
    <div class="mt-16 grid gap-10 border-t border-line pt-12 lg:grid-cols-[0.8fr_1.2fr]">
      <SectionHeading eyebrow="Gambaran Umum" title="Tentang Gampong Madat" />
      <div class="space-y-5">
        {
          profil.gambaranUmum.map((p, i) => (
            <p
              class:list={[
                'leading-[1.8] text-ink-2',
                i === 0 &&
                  'text-[1.0625rem] first-letter:float-left first-letter:mr-2.5 first-letter:font-display first-letter:text-[3.25rem] first-letter:font-semibold first-letter:leading-[0.85] first-letter:text-clay-600',
              ]}
            >
              {p}
            </p>
          ))
        }

        {
          profil.asalUsul ? (
            <div class="border-t border-line pt-5">
              <h3 class="font-display text-lg font-semibold text-padi-900">Asal-usul Nama</h3>
              {profil.asalUsul.map((p) => (
                <p class="mt-3 leading-[1.8] text-ink-2">{p}</p>
              ))}
            </div>
          ) : (
            <p class="border-l-[3px] border-line pl-4 text-sm italic leading-relaxed text-ink-3">
              Naskah sejarah dan asal-usul nama Gampong Madat masih dalam proses penyusunan bersama
              tokoh masyarakat gampong.
            </p>
          )
        }
      </div>
    </div>

    <!-- Visi & Misi -->
    <div class="mt-16 border-t border-line pt-12">
      <SectionHeading
        eyebrow="Arah Pembangunan"
        title="Visi & Misi Gampong"
        description="Rumusan cita-cita dan langkah kerja pemerintah gampong."
      />

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="relative overflow-hidden bg-padi-900 p-8">
          <Icon name="lucide:target" class="h-7 w-7 text-clay-400" />
          <p class="mt-5 text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-clay-300">
            Visi
          </p>
          <p class="mt-3 font-display text-xl font-medium italic leading-relaxed text-paper">
            “{profil.visi}”
          </p>
        </div>

        <div class="card p-8">
          <Icon name="lucide:scroll-text" class="h-7 w-7 text-padi-600" />
          <p class="mt-5 text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-ink-3">
            Misi
          </p>
          <ol class="mt-4 space-y-3.5">
            {
              profil.misi.map((m, i) => (
                <li class="flex gap-3.5">
                  <span class="stat-figure shrink-0 text-lg text-clay-500">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-[0.9375rem] leading-relaxed text-ink-2">{m}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>

    <!-- Sarana & prasarana -->
    <div class="mt-16 border-t border-line pt-12">
      <SectionHeading
        eyebrow="Sarana & Prasarana"
        title="Fasilitas di Gampong Madat"
        description="Sebagai pusat pemerintahan kecamatan, Gampong Madat memiliki sarana layanan publik yang melayani warga gampong dan sekitarnya."
      />

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {
          fasilitas.map((k) => (
            <div class="card p-6">
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[3px] bg-padi-50 text-padi-700">
                  <Icon name={`lucide:${k.icon}`} class="h-5 w-5" />
                </span>
                <div>
                  <h3 class="font-display text-lg font-semibold leading-tight text-padi-900">
                    {k.kategori}
                  </h3>
                  <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-ink-3">
                    {k.items.length} sarana
                  </p>
                </div>
              </div>

              <ul class="mt-5 space-y-3 border-t border-line pt-4">
                {k.items.map((f) => (
                  <li class="flex gap-3">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-clay-500" />
                    <div>
                      <p class="text-[0.9375rem] font-semibold leading-snug text-padi-900">
                        {f.nama}
                      </p>
                      <p class="mt-0.5 text-sm leading-relaxed text-ink-3">{f.keterangan}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Batas wilayah -->
    <div class="mt-16 border-t border-line pt-12">
      <SectionHeading
        eyebrow="Geografis"
        title="Batas Wilayah"
        description="Wilayah yang berbatasan langsung dengan Gampong Madat."
      />

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          profil.batasWilayah.map((b) => (
            <div class="card p-5">
              <div class="flex items-center gap-2 text-padi-600">
                <Icon name={`lucide:${arahIcon[b.arah] ?? 'compass'}`} class="h-4 w-4" />
                <span class="text-[0.6875rem] font-semibold uppercase tracking-[0.14em]">
                  Sebelah {b.arah}
                </span>
              </div>
              <p class="mt-2.5 text-[0.9375rem] leading-snug text-ink-2">{b.keterangan}</p>
            </div>
          ))
        }
      </div>

      <a href="/peta" class="link-underline mt-8 inline-block text-sm">
        Lihat peta wilayah gampong
      </a>
    </div>
  </section>
</Layout>
