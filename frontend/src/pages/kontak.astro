---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { kontak } from '../data/kontak';
import { site } from '../data/site';
---

<Layout title="Kontak" description="Informasi kontak dan lokasi kantor Gampong Madat.">
  <PageHeader
    eyebrow="Hubungi Kami"
    title="Kontak Gampong Madat"
    description="Sampaikan pertanyaan, aspirasi, atau keperluan administrasi kepada perangkat gampong."
  />

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="grid gap-6 lg:grid-cols-3">
      <div class="card p-7">
        <Icon name="lucide:map-pin" class="h-6 w-6 text-clay-600" />
        <h2 class="mt-4 font-display text-lg font-semibold text-padi-900">Alamat Kantor</h2>
        <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">{kontak.alamat}</p>
      </div>

      <div class="card p-7">
        <Icon name="lucide:clock" class="h-6 w-6 text-clay-600" />
        <h2 class="mt-4 font-display text-lg font-semibold text-padi-900">Jam Layanan</h2>
        <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">{kontak.jamLayanan}</p>
        <p class="mt-1 text-sm text-ink-3">Di luar jam tersebut, layanan menyesuaikan.</p>
      </div>

      <div class="card p-7">
        <Icon name="lucide:phone" class="h-6 w-6 text-clay-600" />
        <h2 class="mt-4 font-display text-lg font-semibold text-padi-900">Kontak Langsung</h2>
        <ul class="mt-2 space-y-2 text-[0.9375rem] text-ink-2">
          <li>{kontak.telepon}</li>
          <li class="break-all">{kontak.email}</li>
        </ul>
        <a
          href={`https://wa.me/${kontak.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost mt-5"
        >
          <Icon name="lucide:message-circle" class="h-4 w-4" />
          Chat via WhatsApp
        </a>
      </div>
    </div>

    <div class="relative mt-12 overflow-hidden bg-padi-900 px-8 py-12 sm:px-12">
      <div
        class="absolute inset-0 opacity-[0.06]"
        style="background-image: radial-gradient(circle at 1px 1px, #faf6ef 1px, transparent 0); background-size: 24px 24px;"
      >
      </div>
      <div
        class="relative flex flex-col items-start justify-between gap-7 lg:flex-row lg:items-center"
      >
        <div class="max-w-lg">
          <p class="eyebrow text-clay-300!">Lokasi</p>
          <h2 class="mt-4 font-display text-2xl font-semibold leading-snug text-paper sm:text-3xl">
            Lihat batas wilayah {site.name}
          </h2>
          <p class="mt-3 leading-relaxed text-paper-3/75">
            Peta interaktif menampilkan batas tiap dusun berdasarkan data pemetaan resmi.
          </p>
        </div>
        <a href="/peta" class="btn shrink-0 bg-clay-500 text-paper hover:bg-clay-600">
          Buka Peta Wilayah
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>
</Layout>
