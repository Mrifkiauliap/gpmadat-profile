---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PlaceholderNotice from '../components/PlaceholderNotice.astro';
import StatCard from '../components/StatCard.astro';
import { penduduk, adaRincianDusun } from '../data/penduduk';
import { wilayah } from '../data/profil';

const persenLaki = (penduduk.lakiLaki / penduduk.totalJiwa) * 100;
const persenPerempuan = (penduduk.perempuan / penduduk.totalJiwa) * 100;
const maxJiwaDusun = Math.max(...penduduk.dusun.map((d) => d.jiwa ?? 0), 1);
const rataPerKK = (penduduk.totalJiwa / penduduk.totalKK).toFixed(1);
---

<Layout title="Data Penduduk" description="Statistik kependudukan Gampong Madat.">
  <PageHeader
    eyebrow="Demografi"
    title="Data Kependudukan"
    description="Gambaran jumlah penduduk, komposisi jenis kelamin, dan sebaran warga di setiap dusun."
  />

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <PlaceholderNotice message={penduduk.sumber} />

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <StatCard
        icon="users"
        label="Total Penduduk"
        value={penduduk.totalJiwa.toLocaleString('id-ID')}
        sub="Jiwa"
      />
      <StatCard
        icon="house"
        label="Kepala Keluarga"
        value={penduduk.totalKK.toLocaleString('id-ID')}
        sub={`Rata-rata ${rataPerKK} jiwa/KK`}
      />
      <StatCard
        icon="mars"
        label="Laki-laki"
        value={penduduk.lakiLaki.toLocaleString('id-ID')}
        sub={`${persenLaki.toFixed(1)}% dari total`}
      />
      <StatCard
        icon="venus"
        label="Perempuan"
        value={penduduk.perempuan.toLocaleString('id-ID')}
        sub={`${persenPerempuan.toFixed(1)}% dari total`}
      />
    </div>

    <!-- Rasio gender -->
    <div class="mt-16 border-t border-line pt-12">
      <SectionHeading
        eyebrow="Komposisi"
        title="Rasio Jenis Kelamin"
        description="Perbandingan jumlah penduduk laki-laki dan perempuan di Gampong Madat."
      />

      <div class="card mt-8 p-7">
        <div class="flex h-9 overflow-hidden rounded-[2px]">
          <div
            class="flex items-center justify-start bg-padi-700 pl-3.5 text-xs font-semibold text-paper"
            style={`width: ${persenLaki}%`}
          >
            {persenLaki.toFixed(1)}%
          </div>
          <div
            class="flex items-center justify-end bg-clay-500 pr-3.5 text-xs font-semibold text-paper"
            style={`width: ${persenPerempuan}%`}
          >
            {persenPerempuan.toFixed(1)}%
          </div>
        </div>

        <div class="mt-5 flex flex-wrap justify-between gap-4 text-sm">
          <span class="flex items-center gap-2.5">
            <span class="h-2.5 w-2.5 rounded-full bg-padi-700"></span>
            <span class="text-ink-2">Laki-laki</span>
            <span class="font-semibold text-padi-900">
              {penduduk.lakiLaki.toLocaleString('id-ID')} jiwa
            </span>
          </span>
          <span class="flex items-center gap-2.5">
            <span class="h-2.5 w-2.5 rounded-full bg-clay-500"></span>
            <span class="text-ink-2">Perempuan</span>
            <span class="font-semibold text-padi-900">
              {penduduk.perempuan.toLocaleString('id-ID')} jiwa
            </span>
          </span>
        </div>
      </div>
    </div>

    <!-- Sebaran dusun -->
    <div class="mt-16 border-t border-line pt-12">
      <SectionHeading
        eyebrow={`${penduduk.dusun.length} Wilayah`}
        title="Wilayah Dusun"
        description={
          adaRincianDusun
            ? 'Perbandingan jumlah jiwa dan kepala keluarga di setiap dusun.'
            : `Gampong Madat terbagi ke dalam ${wilayah.jumlahDusun} dusun dengan luas keseluruhan ${wilayah.luasHektar.toLocaleString('id-ID')} hektar.`
        }
      />

      {
        adaRincianDusun ? (
          <div class="mt-8 space-y-3">
            {penduduk.dusun.map((d) => (
              <div class="card p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                  <h3 class="font-display text-lg font-semibold text-padi-900">Dusun {d.nama}</h3>
                  <p class="text-sm text-ink-3">
                    <span class="stat-figure text-xl text-padi-800">
                      {d.jiwa?.toLocaleString('id-ID')}
                    </span>
                    <span class="ml-1">jiwa</span>
                    <span class="mx-2 text-line">|</span>
                    <span class="font-semibold text-ink-2">{d.kk}</span> KK
                  </p>
                </div>

                <div class="mt-3.5 h-1.5 w-full overflow-hidden rounded-full bg-paper-3">
                  <div
                    class="h-full rounded-full bg-padi-600"
                    style={`width: ${((d.jiwa ?? 0) / maxJiwaDusun) * 100}%`}
                  />
                </div>

                <div class="mt-3 flex gap-5 text-xs text-ink-3">
                  <span>
                    Laki-laki: <b class="text-ink-2">{d.lakiLaki}</b>
                  </span>
                  <span>
                    Perempuan: <b class="text-ink-2">{d.perempuan}</b>
                  </span>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <>
            <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {penduduk.dusun.map((d, i) => (
                <div class="card card-hover p-5">
                  <p class="stat-figure text-2xl text-clay-500">
                    {String(i + 1).padStart(2, '0')}
                  </p>
                  <h3 class="mt-2 font-display text-lg font-semibold leading-snug text-padi-900">
                    Dusun {d.nama}
                  </h3>
                </div>
              ))}
            </div>

            <p class="mt-6 text-sm leading-relaxed text-ink-3">
              Rincian jumlah jiwa dan kepala keluarga per dusun belum tersedia. Data yang terhimpun
              saat ini baru mencakup angka keseluruhan gampong.
            </p>
          </>
        )
      }

      <a href="/peta" class="link-underline mt-8 inline-block text-sm">
        Lihat batas tiap dusun pada peta
      </a>
    </div>
  </section>
</Layout>
