---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title,
  description = site.description,
  image,
  type = 'website',
  publishedTime,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;

// `build.format: 'file'` membuat pathname berakhiran ".html", sedangkan Vercel
// (cleanUrls) menyajikannya tanpa ekstensi. Canonical harus menunjuk URL final
// yang benar-benar disajikan, bukan versi yang dialihkan.
const cleanPath =
  Astro.url.pathname
    .replace(/\/index\.html$/, '/')
    .replace(/\.html$/, '')
    .replace(/(.+)\/$/, '$1') || '/';
const canonicalURL = new URL(cleanPath, Astro.site);

// Kartu Open Graph di WhatsApp, Facebook, dan X hanya bisa diandalkan untuk
// JPEG/PNG — SVG dan WebP tidak dirender. Cover kegiatan disimpan sebagai WebP
// demi bobot halaman, jadi untuk og:image dipakai gambar bawaan PNG.
const requested = image ?? site.ogImage;
const ogSafe = /\.(png|jpe?g)$/i.test(requested);
const resolvedImage = ogSafe ? requested : site.ogImage;
const ogImageURL = new URL(resolvedImage, Astro.site);

// Dimensi hanya diklaim untuk gambar bawaan yang ukurannya memang diketahui.
const isDefaultImage = resolvedImage === site.ogImage;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentOrganization',
  name: site.name,
  alternateName: `Pemerintah ${site.name}`,
  url: new URL('/', Astro.site).toString(),
  logo: new URL(site.logo, Astro.site).toString(),
  image: ogImageURL.toString(),
  description: site.description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.alamatKantor,
    addressLocality: site.kecamatan,
    addressRegion: site.provinsi,
    addressCountry: 'ID',
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: `${site.name}, ${site.kecamatan}, ${site.kabupaten}`,
  },
};
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#1a4130" />

		<Font cssVariable="--font-fraunces" preload />
		<Font cssVariable="--font-archivo" preload />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content="index, follow" />

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:locale" content="id_ID" />

		{
			isDefaultImage && (
				<>
					<meta property="og:image:width" content="1200" />
					<meta property="og:image:height" content="630" />
				</>
			)
		}

		{
			type === 'article' && publishedTime && (
				<meta property="article:published_time" content={publishedTime.toISOString()} />
			)
		}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script
			type="application/ld+json"
			set:html={JSON.stringify(jsonLd)}
		/>
	</head>
	<body>
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
